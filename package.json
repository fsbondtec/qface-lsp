{
  "name": "qface-lsp",
  "displayName": "QFace IDL",
  "description": "Syntax highlighting and diagnostics for the QFace interface definition language",
  "version": "0.1.0",
  "publisher": "fsbondtec",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/fsbondtec/qface-lsp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsbondtec/qface-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/fsbondtec/qface-lsp/issues"
  },
  "keywords": [
    "qface",
    "idl",
    "interface definition language",
    "qtinterfaceframework",
    "language server"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:qface"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "qface",
        "aliases": [
          "QFace",
          "qface"
        ],
        "extensions": [
          ".qface"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qface",
        "scopeName": "source.qface",
        "path": "./syntaxes/qface.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "qface.restartServer",
        "title": "QFace: Restart Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "QFace",
      "properties": {
        "qface.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Python interpreter used to run the QFace language server. The interpreter must have `pygls` and `qface` installed (see the extension README). Use an absolute path to point at a virtual environment, for example `${workspaceFolder}/.venv/Scripts/python.exe`."
        },
        "qface.server.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Enable the Python language server, which provides diagnostics. Disable this to use syntax highlighting only, without requiring a Python installation."
        },
        "qface.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the QFace language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle -- --production",
    "bundle": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && npm run bundle",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
