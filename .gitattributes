# Normalize line endings in the repository; check out native on each platform.
* text=auto

*.ts       text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.py       text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
