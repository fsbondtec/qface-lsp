{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "dependsOrder": "sequence",
      "dependsOn": ["npm: check-types", "npm: bundle"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "check-types",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "bundle",
      "problemMatcher": ["$esbuild"]
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": ["$esbuild-watch"]
    }
  ]
}
